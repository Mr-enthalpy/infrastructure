# Example only: the legacy intake/apply UI remains a separate, VPN-only vhost.
# It is not part of the Portal and must not be given resource/admin routes.
# DNS, certificates, VPN routing, and firewall source ranges are owned by
# server management.  Bind the campus/VPN-facing private address, never the
# public interface; the placeholder must be replaced during deployment.

server {
    listen <host-private-ip>:443 ssl;
    server_name citespec-apply.<lab-domain>;

    ssl_certificate     /etc/ssl/citespec/citespec-apply.fullchain.pem;
    ssl_certificate_key /etc/ssl/citespec/citespec-apply.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 64k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Citespec-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
