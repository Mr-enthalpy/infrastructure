[Unit]
Description=UDC shared GPU resource broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Environment=UDC_RESOURCE_CONFIG=/etc/udc-resource/config.toml
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=udc-resource
RuntimeDirectoryMode=0711
StateDirectory=udc-resource
StateDirectoryMode=0750
UMask=0077
ExecStart=/opt/udc-resource/.venv/bin/python -m udc_resource.broker
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# The broker reads member authorized_keys for container SSH and runs the GPU
# audit as members. Home directories must stay readable, but never writable.
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/udc-resource /run/udc-resource
ReadWritePaths=-/data1/udc-users
# Docker's Unix socket is a file path; keep it usable under ProtectSystem=strict.
ReadWritePaths=-/run/docker.sock
ReadWritePaths=-/var/run/docker.sock

[Install]
WantedBy=multi-user.target
