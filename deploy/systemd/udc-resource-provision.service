[Unit]
Description=UDC membership provisioning executor (root, fixed actions only)
After=network.target

[Service]
# Goal member-onboarding-and-ux.md §8.2: narrow root-owned executor. It reads
# one request JSON per invocation (fixed actions, field whitelist) via the
# spool directory the broker writes into, and never accepts shell strings,
# arbitrary paths, UIDs, groups, or unit names.
Type=oneshot
ExecStart=/opt/udc-resource/.venv/bin/python /usr/local/libexec/udc-resource/provision_executor.py --spool /var/lib/udc-resource/provision
User=root
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc /home /data1/udc-users /var/lib/udc-resource/provision
PrivateTmp=true
# No network needed for account/key/quota work.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
