[Unit]
Description=Check Citespec workspace free disk space
OnFailure=citespec-resource-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/citespec-check-disk --path /home/data1/citespec-users --warn-percent 85 --crit-percent 95 --min-free-gb 200
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=-/home/data1/citespec-users
