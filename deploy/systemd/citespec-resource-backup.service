[Unit]
Description=Back up Citespec state database and configuration
OnFailure=citespec-resource-alert@%n.service

[Service]
Type=oneshot
# Use the installed virtualenv's package module, not a mutable working tree.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/citespec-resource/.venv/bin/python -m citespec_resource.backup backup --config /etc/citespec-resource/config.toml --backup-root /var/backups/citespec-resource --keep 14
User=root
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/citespec-resource
# The default backup checkpoints every live SQLite database with
# wal_checkpoint(TRUNCATE).  ProtectSystem=strict makes /var read-only, so the
# state, intake, and portal directories must be writable for the checkpoint and
# for the -wal/-shm truncation.  The intake/portal paths are optional because a
# monitor-only host may not have created those databases yet.
ReadWritePaths=/var/lib/citespec-resource
ReadWritePaths=-/var/lib/citespec-resource-intake
ReadWritePaths=-/var/lib/citespec-resource-portal
